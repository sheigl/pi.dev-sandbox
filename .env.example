# .env.example — copy to .env and fill in your keys
# NEVER commit your real .env file!

# ══════════════════════════════════════════════════════════
# LiteLLM Proxy
# ══════════════════════════════════════════════════════════

# Your existing LiteLLM master key (required to start the proxy)
LITELLM_MASTER_KEY=sk-litellm-...

# Port the proxy listens on
LITELLM_PORT=4000

# Your existing LiteLLM virtual key — this is what Pi uses to authenticate
LITELLM_VIRTUAL_KEY=sk-...

# ══════════════════════════════════════════════════════════
# LLM Provider Keys — only visible inside the litellm container
# These are the real provider keys behind your virtual keys.
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ══════════════════════════════════════════════════════════
# Sandbox user UID/GID (prevents permission issues with mounted files)
# ══════════════════════════════════════════════════════════
UID=1000
GID=1000