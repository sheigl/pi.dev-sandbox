# .env.example — copy to .env and fill in your keys
# NEVER commit your real .env file!

# ══════════════════════════════════════════════════════════
# LiteLLM Proxy — REQUIRED
# ══════════════════════════════════════════════════════════

# Master key for the proxy (admin access — do NOT share with clients)
LITELLM_MASTER_KEY=sk-litellm-change-me-to-a-secure-random-string

# Port the proxy listens on
LITELLM_PORT=4000

# Virtual keys (generated by setup-keys.sh — DO NOT fill in manually)
# LITELLM_VIRTUAL_KEY=        # ← auto-populated by setup-keys.sh (full access)
# LITELLM_VIRTUAL_KEY_BUDGET= # ← auto-populated by setup-keys.sh (budget tier)

# Optional: Postgres DB for persisting keys, usage, spend tracking
# LITELLM_DATABASE_URL=postgresql://litellm:password@localhost:5432/litellm

# ══════════════════════════════════════════════════════════
# LLM Provider Keys — only visible inside the litellm container
# LiteLLM uses these to call provider APIs. Virtual keys are
# what the Pi sandbox uses to authenticate with the proxy.
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ══════════════════════════════════════════════════════════
# Sandbox user UID/GID (prevents permission issues with mounted files)
# ══════════════════════════════════════════════════════════
UID=1000
GID=1000