# .env.example — copy to .env and fill in your keys
# NEVER commit your real .env file!

# ══════════════════════════════════════════════════════════
# LiteLLM Proxy
# ══════════════════════════════════════════════════════════

# Your existing LiteLLM master key (required to start the proxy)
LITELLM_MASTER_KEY=sk-litellm-...

# Port the proxy listens on
LITELLM_PORT=4000

# ══════════════════════════════════════════════════════════
# Virtual Keys — add as many as you need, name them whatever you want
# Default key for Pi sandbox = LITELLM_VIRTUAL_KEY
# Override at runtime: docker compose run --rm -e OPENAI_API_KEY=$LITELLM_VKEY_CODING pi-sandbox
# ══════════════════════════════════════════════════════════

# Default key (used when you just `docker compose run pi-sandbox`)
LITELLM_VIRTUAL_KEY=sk-...

# Add your named keys here — these are available as env vars for -e overrides
LITELLM_VKEY_FULL=sk-...
LITELLM_VKEY_BUDGET=sk-...
LITELLM_VKEY_CODING=sk-...
LITELLM_VKEY_READONLY=sk-...
# LITELLM_VKEY_YOUR_CUSTOM_NAME=sk-...

# ══════════════════════════════════════════════════════════
# LLM Provider Keys — only visible inside the litellm container
# These are the real provider keys behind your virtual keys.
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ══════════════════════════════════════════════════════════
# Sandbox user UID/GID (prevents permission issues with mounted files)
# ══════════════════════════════════════════════════════════
UID=1000
GID=1000