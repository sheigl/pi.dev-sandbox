# .env.example — copy to .env and fill in your keys
# NEVER commit your real .env file!

# ── LiteLLM Proxy (litellm service only, NOT passed to pi-sandbox) ──
LITELLM_MASTER_KEY=sk-litellm-...
LITELLM_PORT=4000

# ── Virtual Key (REQUIRED for pi-sandbox) ──
# Override at runtime: docker compose run --rm -e OPENAI_API_KEY=sk-other-key pi-sandbox
LITELLM_VIRTUAL_KEY=sk-...

# ── Provider Keys (litellm service only) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ── Sandbox UID/GID ──
UID=1000
GID=1000