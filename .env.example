# .env.example — copy to .env and fill in your keys

# ══════════════════════════════════════════════════════════
# LiteLLM Proxy — REQUIRED
# ══════════════════════════════════════════════════════════
# Master key for the proxy (use this as OPENAI_API_KEY in clients)
LITELLM_MASTER_KEY=sk-litellm-change-me-to-a-secure-random-string
# Port the proxy listens on (default 4000)
LITELLM_PORT=4000
# Optional: Postgres DB for persisting keys, usage, spend tracking
# LITELLM_DATABASE_URL=postgresql://litellm:password@localhost:5432/litellm

# ══════════════════════════════════════════════════════════
# LLM Provider Keys — uncomment and fill in the ones you use
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ══════════════════════════════════════════════════════════
# Sandbox user UID/GID (prevents permission issues with mounted files)
# ══════════════════════════════════════════════════════════
UID=1000
GID=1000